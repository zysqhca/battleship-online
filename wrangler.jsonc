{
  "name": "battleship-online",
  "main": "src/index.js",
  "compatibility_date": "2026-04-07",
  "assets": {
    "directory": "./public/",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [
      { "name": "HUB", "class_name": "Hub" }
    ]
  },
  "exports": {
    "Hub": { "type": "durable-object", "storage": "sqlite" }
  }
}
